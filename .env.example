APP_NAME="DGS Hair Salon & Spa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production database: Supabase Postgres (Project Settings → Database → Session pooler).
# For local MySQL development use DB_CONNECTION=mysql, DB_HOST=127.0.0.1, DB_PORT=3306, DB_DATABASE=dgs_salon.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_SSLMODE=require
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Use "log" locally; set smtp (or another mailer) plus credentials in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (HTTP v1) service-account credentials.
# Leave empty to disable push delivery (notifications are still stored in the database).
# FCM_PRIVATE_KEY must keep its newlines escaped as \n inside double quotes.
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Comma-separated origins allowed to call the API from a browser (mobile apps do not need this).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"

# Supabase. Push: PUSH_DRIVER=supabase sends pushes from the send-push Edge Function (database trigger);
# PUSH_DRIVER=fcm makes Laravel call FCM directly (local MySQL development).
PUSH_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Project Settings → JWT Keys → Legacy JWT secret. Signs the app's short-lived Realtime tokens.
SUPABASE_JWT_SECRET=
SUPABASE_REALTIME_TOKEN_TTL=3600
# Generated by `php artisan dgs:supabase-push`; must equal the Edge Function secret DGS_PUSH_WEBHOOK_SECRET.
SUPABASE_PUSH_WEBHOOK_SECRET=

# Uploaded images. Local: MEDIA_DISK=public, PRIVATE_MEDIA_DISK=local.
# Supabase Storage: MEDIA_DISK=media, PRIVATE_MEDIA_DISK=media_private + S3 keys (Storage → S3 Configuration).
MEDIA_DISK=media
PRIVATE_MEDIA_DISK=media_private
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_PUBLIC_BUCKET=salon-public
SUPABASE_PRIVATE_BUCKET=salon-private
