APP_NAME="DGS Hair Salon & Spa"
APP_ENV=local
APP_KEY=base64:9Slple+NZZacNccnpEpb2kqKSuYYsRklVF4QnJZRbSY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgs_salon
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Use "log" locally; set smtp (or another mailer) plus credentials in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (HTTP v1) service-account credentials.
# Leave empty to disable push delivery (notifications are still stored in the database).
# FCM_PRIVATE_KEY must keep its newlines escaped as \n inside double quotes.

# Comma-separated origins allowed to call the API from a browser (mobile apps do not need this).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"
FCM_PROJECT_ID=dgs-my-firebase
