# Local demo environment for recording videos. Loaded only when APP_ENV=demo.
# Local MySQL (dgs_demo), local disk storage, Supabase off. Never points at production.
APP_NAME="DGS Hair Salon & Spa"
APP_ENV=demo
APP_KEY=base64:+8eRhXrar55AnJ/6h9j3i0jt13noO0skKoD6Z6x0q4Q=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgs_demo
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
MEDIA_DISK=public
PRIVATE_MEDIA_DISK=local
MAIL_MAILER=log
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Push goes straight to FCM, so only devices registered in dgs_demo receive it.
PUSH_DRIVER=fcm
SUPABASE_URL=
SUPABASE_JWT_SECRET=
FCM_PROJECT_ID=dgs-my-firebase
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@dgs-my-firebase.iam.gserviceaccount.com
